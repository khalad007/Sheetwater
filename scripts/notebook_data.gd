class_name NotebookData
extends RefCounted
## All item descriptions and notebook notes as plain data.
## ITEMS: id -> {name, desc}. Every id used in a hotspot "gives" needs an entry here.
## NOTES: shown in order, each only once its "show_if" conditions are true
##        (same condition syntax as hotspots: "flag:x", "item:x", "!" to negate).
## Notes are Mara's own words. The very first line starts with "Day 1." on purpose.

const ITEMS: Dictionary = {
	"room_key": {
		"name": "Brass key",
		"desc": "A key on a paper tag. The tag has no number, only a smudge where one was rubbed out.",
	},
	"child_drawing": {
		"name": "Child's drawing",
		"desc": "A small hand held inside a larger hand. The crayon was pressed hard enough to tear the paper.",
	},
	"red_boot": {
		"name": "Red rain boot",
		"desc": "A child's boot, still damp inside. The left one. There is no right one.",
	},
	"red_coat": {
		"name": "Red coat",
		"desc": "Small, with a hood. One sleeve is stiff with dried lake water.",
	},
	"voice_tape": {
		"name": "Recording",
		"desc": "A tape of a child's voice. Static cuts out one word, every time you play it.",
	},
	"school_key": {
		"name": "School key",
		"desc": "A rusty iron key. The man with the lantern put it in your hand before you asked.",
	},
}

const NOTES: Array = [
	{"id": "n_arrived",
		"text": "Day 1. Arrived. The bus was empty except for me. No one waiting at the stop.",
		"show_if": ["flag:visited_bus_stop"]},
	{"id": "n_casefile",
		"text": "Case file: girl, 8, last seen by the water. No photo attached. No case number. Nobody is listed as having reported her missing.",
		"show_if": ["flag:arrived"]},
	{"id": "n_sign",
		"text": "The sign at the stop has no name on it. Ask someone what this place is called.",
		"show_if": ["flag:read_sign"]},
	{"id": "n_timetable",
		"text": "The bus timetable lists arrivals only. Nothing seems to leave.",
		"show_if": ["flag:read_timetable"]},
	{"id": "n_firstline",
		"text": "My own notebook already says 'No mirrors.' on the first line. I must have written it on the bus.",
		"show_if": ["flag:read_first_line"]},
	{"id": "n_windows",
		"text": "The glass is frosted. I haven't seen a clear window yet.",
		"show_if": ["flag:looked_window"]},
	{"id": "n_drawing",
		"text": "A child's drawing, in a coat in the wardrobe. A small hand inside a bigger one. I feel like I should know whose it is.",
		"show_if": ["item:child_drawing"]},
	{"id": "n_route",
		"text": "School first, then the lake, then the chapel. Everyone says 'she'. Nobody says her name.",
		"show_if": ["flag:villager_route"]},
	{"id": "n_car",
		"text": "The wing mirrors on the parked car are painted over. Someone did it recently.",
		"show_if": ["flag:saw_car_mirrors"]},
	{"id": "n_school_key",
		"text": "The man with the lantern gave me the school key without my asking. He said everyone goes there first.",
		"show_if": ["item:school_key"]},
	{"id": "n_kept_ready",
		"text": "The woman says my room is 'kept ready. It always is.' I only arrived this morning.",
		"show_if": ["flag:talked_woman"]},
	{"id": "n_ring",
		"text": "A pale band of skin on my ring finger, as if a ring was taken off. I don't remember wearing one.",
		"show_if": ["flag:talked_elder"]},
	{"id": "n_hooks",
		"text": "A row of coat hooks at a child's height. One tag torn off. I should remember whose.",
		"show_if": ["flag:saw_hooks"]},
	{"id": "n_boot",
		"text": "A red boot, left foot only, still damp inside. As if it was worn this morning.",
		"show_if": ["item:red_boot"]},
	{"id": "n_phone",
		"text": "My phone buzzed at the lake. No signal. No caller. I didn't answer it.",
		"show_if": ["flag:phone_buzzed"]},
	{"id": "n_water",
		"text": "The lake doesn't reflect anything. Not the sky, not the reeds. Strange.",
		"show_if": ["flag:saw_water"]},
	{"id": "n_coat",
		"text": "A small red coat on the bench at the end of the jetty, the sleeve stiff with water. Someone small was in that lake. I don't want to finish that thought.",
		"show_if": ["item:red_coat"]},
	{"id": "n_tape",
		"text": "A child's voice on a tape. One word is lost in static, every time. I've played it three times. I know that voice.",
		"show_if": ["flag:played_tape"]},
	{"id": "n_rest",
		"text": "That voice on the tape. I need to sit down somewhere quiet. The inn is the only place that feels like mine.",
		"show_if": ["flag:played_tape"]},
	{"id": "n_pile",
		"text": "Hundreds of notebooks under the bed, in handwriting like mine, every one starting 'Day 1.' Someone is imitating me. That's the only explanation.",
		"show_if": ["flag:found_notebooks"]},
	{"id": "n_chapel",
		"text": "The notebooks that go furthest all stop at the chapel. I should go and see it, whatever is under that sheet.",
		"show_if": ["flag:found_notebooks"]},
	{"id": "n_chapel_window",
		"text": "The chapel window is clear glass, the first clear window in the village. The light from it falls in one long bar across the aisle.",
		"show_if": ["flag:saw_chapel_window"]},
	{"id": "n_sheet",
		"text": "Under the sheet in the chapel, a mirror. My notebook says not to look. I came all this way.",
		"show_if": ["flag:mirror_seen"]},
]
